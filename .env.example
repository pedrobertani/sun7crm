# Variáveis públicas previstas para o frontend React + Vite.
# O cliente é inicializado sob demanda; a demo continua usando o adaptador local.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# No Cloudflare, usar hom somente no ambiente Preview. Não contém segredos.
VITE_BILLING_ENVIRONMENT=main

# SUPABASE_SECRET_KEY é exclusiva do ambiente de backend/Edge Functions.
# Nunca adicionar uma chave secreta em variável VITE_, neste arquivo ou no Git.

